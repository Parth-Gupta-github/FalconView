# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated by tools/planetiler/generate — checked in only as a build
# artifact, never committed (can be 50-250 MB).
/assets/basemap/*.mbtiles
/tools/planetiler/.cache/
/tools/planetiler/*.jar

# Glyph PBFs and sprite atlas fetched by tools/glyphs/fetch and
# tools/sprite/fetch. Small (~1 MB total) but derived from OpenFreeMap —
# devs fetch them locally. The .gitkeep files keep the directory layout.
/assets/glyphs/**/*.pbf
/assets/sprite/*.png
/assets/sprite/*.json
