{
  "version": 8,
  "name": "FalconView Offline Fallback",
  "metadata": {
    "comment": "Stripped-down style used when the device is offline and no region has been downloaded. Reads from the in-app BundledBasemapServer — `sources.openmaptiles.tiles` is patched in at runtime by loadOfflineRenderStyle(). No glyphs / no sprite — text and POI symbol layers are omitted on purpose so the basemap renders without bundling font PBFs or sprite atlases."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["RUNTIME_PATCHED"],
      "minzoom": 0,
      "maxzoom": 6
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#E8EEF2" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": { "fill-color": "#C8DCC0", "fill-opacity": 0.9 }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": { "fill-color": "#D5E5CC", "fill-opacity": 0.8 }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "sand"],
      "paint": { "fill-color": "#F0E8CC" }
    },
    {
      "id": "landcover-ice",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "ice"],
      "paint": { "fill-color": "#EAF2F6" }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": { "fill-color": "#EDEDED", "fill-opacity": 0.6 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", "intermittent", 1],
      "paint": { "fill-color": "#AAD3DF" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#AAD3DF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 0, 0.3, 6, 1.2]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 2],
      "paint": {
        "line-color": "#8A99A8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 0, 0.4, 6, 1.4],
        "line-opacity": 0.85
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 4],
      "paint": {
        "line-color": "#A8B4C0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 2, 0.3, 6, 1.0],
        "line-opacity": 0.7,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#F4B400",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.5, 6, 2.0]
      }
    },
    {
      "id": "road-trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "trunk"],
      "paint": {
        "line-color": "#F8D079",
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.4, 6, 1.6]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.3, 6, 1.2]
      }
    }
  ]
}
