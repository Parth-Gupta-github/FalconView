{
  "version": 8,
  "name": "FalconView Offline",
  "metadata": {
    "comment": "Offline style for FalconView. Reads from the in-app BundledBasemapServer — `sources.openmaptiles.tiles` is patched at runtime by loadOfflineRenderStyle(). Renders a clean palette across the full bundled zoom range. No glyphs / no sprite (yet) — text labels and POI icons are omitted; POIs render as colored dots so they're still visible at z12+."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["RUNTIME_PATCHED"],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#E8EEF2" } },

    { "id": "landcover-wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", "class", "wood"], "paint": { "fill-color": "#C8DCC0", "fill-opacity": 0.9 } },
    { "id": "landcover-grass", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", "class", "grass"], "paint": { "fill-color": "#D5E5CC", "fill-opacity": 0.8 } },
    { "id": "landcover-sand", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", "class", "sand"], "paint": { "fill-color": "#F0E8CC" } },
    { "id": "landcover-ice", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", "class", "ice"], "paint": { "fill-color": "#EAF2F6" } },

    { "id": "landuse-residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["==", "class", "residential"], "paint": { "fill-color": "#EDEDED", "fill-opacity": 0.6 } },
    { "id": "landuse-commercial", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["==", "class", "commercial"], "minzoom": 10,
      "paint": { "fill-color": "#FFF4D6", "fill-opacity": 0.7 } },
    { "id": "landuse-industrial", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["==", "class", "industrial"], "minzoom": 10,
      "paint": { "fill-color": "#E6E0EA", "fill-opacity": 0.6 } },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park", "minzoom": 8,
      "paint": { "fill-color": "#CFE5C0", "fill-opacity": 0.7 } },

    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "filter": ["!=", "intermittent", 1], "paint": { "fill-color": "#AAD3DF" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "paint": {
        "line-color": "#AAD3DF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 0, 0.3, 14, 2.0]
      } },

    { "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#E0DACF",
        "fill-outline-color": "#CFC7B8",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 14, 0.9]
      } },

    { "id": "boundary-country", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["==", "admin_level", 2],
      "paint": {
        "line-color": "#8A99A8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 0, 0.4, 6, 1.4],
        "line-opacity": 0.85
      } },
    { "id": "boundary-state", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["==", "admin_level", 4],
      "paint": {
        "line-color": "#A8B4C0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 2, 0.3, 6, 1.0],
        "line-opacity": 0.7,
        "line-dasharray": [3, 2]
      } },

    { "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"], "minzoom": 13,
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.5, 14, 1.5]
      } },
    { "id": "road-residential", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "residential"], "minzoom": 12,
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.6, 14, 2.2]
      } },
    { "id": "road-tertiary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "tertiary"], "minzoom": 10,
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 3.0]
      } },
    { "id": "road-secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "secondary"], "minzoom": 8,
      "paint": {
        "line-color": "#FFF8DC",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 3.6]
      } },
    { "id": "road-primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#FFE082",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.3, 14, 4.4]
      } },
    { "id": "road-trunk", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "trunk"],
      "paint": {
        "line-color": "#F8D079",
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.4, 14, 4.8]
      } },
    { "id": "road-motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#F4B400",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.5, 14, 5.5]
      } },
    { "id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "rail"], "minzoom": 11,
      "paint": {
        "line-color": "#9AA0A6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.4, 14, 1.6],
        "line-dasharray": [3, 2]
      } },

    {
      "id": "poi-emergency",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 13,
      "filter": ["in", "class",
        "hospital", "doctors", "police", "fire_station"
      ],
      "paint": {
        "circle-color": "#D32F2F",
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 13, 2, 14, 4],
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 1
      }
    },
    {
      "id": "poi-transport",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 13,
      "filter": ["in", "class",
        "railway", "bus", "aerialway", "airport", "fuel"
      ],
      "paint": {
        "circle-color": "#1976D2",
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 13, 2, 14, 4],
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 1
      }
    },
    {
      "id": "poi-food",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "filter": ["in", "class",
        "restaurant", "fast_food", "cafe", "bar", "ice_cream", "food_court", "biergarten"
      ],
      "paint": {
        "circle-color": "#F57C00",
        "circle-radius": 3.2,
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 1
      }
    },
    {
      "id": "poi-education",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "filter": ["in", "class",
        "school", "college", "university", "kindergarten", "library"
      ],
      "paint": {
        "circle-color": "#7B1FA2",
        "circle-radius": 3.2,
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 1
      }
    },
    {
      "id": "poi-other",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "filter": ["!in", "class",
        "hospital", "doctors", "police", "fire_station",
        "railway", "bus", "aerialway", "airport", "fuel",
        "restaurant", "fast_food", "cafe", "bar", "ice_cream", "food_court", "biergarten",
        "school", "college", "university", "kindergarten", "library"
      ],
      "paint": {
        "circle-color": "#546E7A",
        "circle-radius": 2.4,
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 0.8,
        "circle-opacity": 0.85
      }
    }
  ]
}
