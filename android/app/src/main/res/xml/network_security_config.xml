<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy.

  Android 9+ blocks cleartext (plain HTTP) traffic by default. Our in-app
  BundledBasemapServer serves vector tiles over http://127.0.0.1:<port>/ so
  MapLibre can fetch them — but that's cleartext too.

  This config keeps the secure default for ALL real hosts and only allows
  cleartext for the loopback interface, where it cannot leave the device.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
